 "query": "SELECT p.name, p.posting_date, c.reference_name, s.custom_folio_fiscal, c.total_amount\nFROM `tabPayment Entry` AS p\nJOIN `tabPayment Entry Reference` AS c\nON p.name=c.parent\nJOIN `tabSales Invoice` as s\nON c.reference_name=s.name\nWHERE p.custom_status_payment_ppd=\"Sin Facturar\" AND p.docstatus=1 AND p.payment_type=\"Receive\" AND s.custom_metodo_de_pago=\"PPD\" AND s.posting_date >= \"2025-01-01\"\n",
