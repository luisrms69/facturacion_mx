 "prepared_report": 0,
 "query": "SELECT p.name, p.posting_date, p.paid_amount, c.reference_name, s.custom_folio_fiscal, c.total_amount\nFROM `tabPayment Entry` AS p\nJOIN `tabPayment Entry Reference` AS c\nON p.name=c.parent\nJOIN `tabSales Invoice` as s\nON c.reference_name=s.name\nWHERE p.custom_status_payment_ppd=\"Sin Facturar\"\nAND p.docstatus=1\nAND p.payment_type=\"Receive\"\nAND s.custom_metodo_de_pago=\"PPD\"\nAND s.posting_date >=\"2025-01-01\"\nAND p.posting_date between \"2025-01-01\" and %(fecha_tope)s\nORDER BY p.posting_date ASC",
 "ref_doctype": "Payment Entry",
